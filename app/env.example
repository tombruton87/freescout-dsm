# What the setup container writes to .env beside compose.yaml. On a Synology
# every value comes from the install wizard or the FreeScout window; on any
# other box, copy this to .env and fill it in.
HTTP_PORT=8060
LAN_IP=192.168.1.10
TZ=Europe/London
# How people reach FreeScout. Must be the address in the browser, or links
# and redirects break: http://<NAS address>:<port>, or https://<domain> when
# DSM's reverse proxy fronts it (then set the two proxy lines).
APP_URL=http://192.168.1.10:8060
TRUSTED_PROXIES=unset
SECURE_COOKIE=unset
# Database passwords: made once, kept here, never asked for.
DB_PASS=change-me
DB_ROOT_PASS=change-me-too
# The first administrator, made on a fresh database only. Their password is
# given to the first `docker compose up` through the environment, not here.
ADMIN_EMAIL=admin@example.com
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
# Pin the images if you want a known version rather than latest.
FREESCOUT_IMAGE=nfrastack/freescout:latest
MARIADB_IMAGE=mariadb:11.4
