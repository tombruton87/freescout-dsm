#!/bin/sh
. "$(dirname "$0")/common"
log "${SYNOPKG_PKG_STATUS:-} ${SYNOPKG_PKGVER:-}"

# The install wizard's answers (WIZARD_UIFILES/install_uifile.sh), left for the
# setup container as KEY='value' lines. The wizard checked them; they're
# narrowed to their own characters again here, because a shell will read them
# (as data — see setup/run.sh read_settings). The administrator's password is
# hex-encoded so no character of it can mean anything to a shell; run.sh
# decodes it, hands it to the first start, and removes it from this file.
only() { printf '%s' "$1" | tr -cd "$2"; }
hex() { printf '%s' "$1" | od -An -v -tx1 | tr -d ' \n'; }
if [ -n "${wizard_lan_ip:-}" ]; then
  {
    echo "FS_LAN_IP='$(only "$wizard_lan_ip" '0-9.')'"
    echo "FS_TZ='$(only "${wizard_tz:-}" 'A-Za-z0-9_/+-')'"
    echo "FS_HTTP_PORT='$(only "${wizard_http_port:-8060}" '0-9')'"
    echo "FS_ADMIN_EMAIL='$(only "${wizard_admin_email:-}" 'A-Za-z0-9._+@-')'"
    echo "FS_ADMIN_FIRST='$(only "${wizard_admin_first:-Admin}" 'A-Za-z0-9._-')'"
    echo "FS_ADMIN_LAST='$(only "${wizard_admin_last:-User}" 'A-Za-z0-9._-')'"
    echo "FS_ADMIN_PASS_HEX='$(hex "${wizard_admin_pass:-}")'"
    # FreeScout's files are the package's: anything run.sh makes for the window
    # is owned by this user, which is who the window's api.cgi runs as.
    echo "FS_HOST_UID='$(id -u)'"
    echo "FS_HOST_GID='$(id -g)'"
  } > "$VAR/answers.env.tmp" && mv "$VAR/answers.env.tmp" "$VAR/answers.env"
  chmod 600 "$VAR/answers.env" 2>/dev/null
  log "wizard: address $wizard_lan_ip, port ${wizard_http_port:-}, time zone ${wizard_tz:-}, administrator ${wizard_admin_email:-}"
fi
exit 0
