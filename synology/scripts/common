# What the package's scripts share. Package Center runs them as the package's
# own user, which can't use Docker — the setup container (setup/run.sh) does
# the work; these leave it answers and notes.

VAR="${SYNOPKG_PKGVAR:-/var/packages/freescout/var}"

# A line in the package's log, which the setup container's lines join.
log() { echo "$(date '+%Y-%m-%d %H:%M:%S')  [$(basename "$0")] $*" >> "$VAR/package.log" 2>/dev/null; }
